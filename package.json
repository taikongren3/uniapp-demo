{
  "name": "uniapp-multiplatform-starter",
  "version": "1.0.0",
  "private": true,
  "description": "面向微信小程序、支付宝小程序和 H5 的可维护 uni-app 工程",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.19.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm format:check"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-alipay": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@eslint/js": "9.32.0",
    "@types/node": "20.17.30",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "0.5.1",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.3.0",
    "prettier": "3.6.2",
    "sass": "1.89.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "vite": "5.2.8",
    "vitest": "1.6.1",
    "vue-tsc": "2.0.29"
  }
}
